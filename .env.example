# Database Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (web) — from a Google Cloud Console OAuth client, type
# "Web application", authorized redirect URI:
# <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mirrors whether the two vars above are set — NEXT_PUBLIC_ vars are baked
# in at build time and can't read server-only env vars, so this has to be
# kept in sync by hand. Controls whether the "Continue with Google" button
# renders on /auth/login.
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=false

# Google sign-in (mobile) — same Google Cloud project, but separate OAuth
# client IDs (type "iOS" / "Android" / "Web", the last used by Expo Go /
# the AuthSession proxy). GOOGLE_CLIENT_ID above (the web one) doubles as
# the token audience the mobile endpoint verifies against.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database - PgBouncer pooler URL (port 6432) for runtime queries.
# Add ?pgbouncer=true when using Supabase's built-in pooler.
# connection_limit=1 lets PgBouncer manage the pool size.
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/stellar_portfolio?schema=public&pgbouncer=true&connection_limit=1"

# Direct connection to Postgres (port 5432) — used only by Prisma Migrate.
# Must bypass PgBouncer; never used for application queries.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellar_portfolio?schema=public"

# Auth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# tRPC & JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Push notifications: bearer token that lets backend services call
# POST/PUT /api/notifications/push. Signed-in admins can call them without it.
PUSH_SERVICE_TOKEN="generate-a-long-random-string"

# Backend API Configuration
API_HOST="127.0.0.1" 
API_PORT=3001
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
# Object storage (lib/storage/s3.ts). S3_* values override the AWS_* ones
# above; set S3_ENDPOINT for S3-compatible stores such as MinIO or R2.
S3_BUCKET="your-bucket-name"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""
# Lifetime of signed download URLs, in seconds.
SIGNED_URL_TTL_SECONDS=900

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stellar Network Configuration (#1346)
# ─────────────────────────────────────────────────────────────────────────────
# Set to "mainnet" for production, "testnet" for staging / local dev.
# Any value other than "mainnet" defaults to testnet (fail-safe behaviour).
# NEXT_PUBLIC_ vars are baked in at build time — restart "pnpm dev" after
# changing them; editing .env.local alone will NOT pick them up at runtime.
#
# When IS_TESTNET is true the app renders a visible amber banner so users are
# never confused about which network they are operating on.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Testnet RPC pool (used when NEXT_PUBLIC_STELLAR_NETWORK=testnet)
NEXT_PUBLIC_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_TESTNET_RPC_URL_2=https://testnet.stellar.validationcloud.io/v1/soroban/rpc
NEXT_PUBLIC_TESTNET_PASSPHRASE="Test SDF Network ; September 2015"
# Horizon REST API for testnet (SEP-24, path payments, etc.)
NEXT_PUBLIC_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org

# Mainnet RPC pool — primary + fallbacks (rpc-fallback.ts rotates on failure)
NEXT_PUBLIC_MAINNET_RPC_URL=https://soroban-mainnet.stellar.org
NEXT_PUBLIC_MAINNET_RPC_URL_2=https://mainnet.stellar.validationcloud.io/v1/soroban/rpc
NEXT_PUBLIC_MAINNET_RPC_URL_3=https://rpc.ankr.com/stellar_soroban
NEXT_PUBLIC_MAINNET_PASSPHRASE="Public Global Stellar Network ; September 2015"
# Horizon REST API for mainnet
NEXT_PUBLIC_MAINNET_HORIZON_URL=https://horizon.stellar.org

CONTRACT_ID=
# Soroban identity contract address, used by the KYC review flow's
# verify_kyc call (Issue #782).
IDENTITY_CONTRACT_ID=
# STELLAR_ADMIN_SECRET is only read from env when KMS_PROVIDER=env (local/CI).
# In production it is fetched from AWS Secrets Manager; leave blank here.
STELLAR_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Key Management (KMS) — Issue #1347
# ---------------------------------------------------------------------------
# KMS_PROVIDER=env    → read secrets from environment variables (default, local/CI)
# KMS_PROVIDER=aws    → fetch secrets from AWS Secrets Manager via CMK
# KMS_PROVIDER=azure  → fetch secrets from Azure Key Vault via managed identity
KMS_PROVIDER=env

# Prefix for Secrets Manager secret IDs when KMS_PROVIDER=aws.
# Must match the SecretPrefix parameter in infrastructure/aws/kms.yaml.
KMS_SECRET_PREFIX=stellar/prod

# AWS region for Secrets Manager (required when KMS_PROVIDER=aws).
# AWS_REGION is also used by the S3 integration above.
# AWS_REGION=us-east-1

# Azure Key Vault — required when KMS_PROVIDER=azure.
# Provision a vault at https://portal.azure.com and paste the vault URI here.
# The app uses DefaultAzureCredential: managed identity in production,
# AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET for CI/local.
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Encryption
# IMPORTANT: Must be a valid 32-byte (64-character) hex string. Never use all zeros.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1"

# Error Tracking & Monitoring
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="development"
ENABLE_ERROR_TRACKING=true

# ---------------------------------------------------------------------------
# Yjs Collaboration WebSocket server (server/collab.ts)
# ---------------------------------------------------------------------------
WS_PORT=1234
WS_HOST=localhost
# How often the server pings each client (ms)
WS_HEARTBEAT_INTERVAL_MS=30000
# Seconds to wait for a pong before terminating the connection (ms)
WS_PONG_DEADLINE_MS=10000
# Close connections with no activity for this long (ms)
WS_IDLE_TIMEOUT_MS=300000
# Public URL used by the Next.js frontend to connect
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# ---------------------------------------------------------------------------
# OpenTelemetry Distributed Tracing (#639)
# ---------------------------------------------------------------------------
# Set to "false" to disable tracing entirely (useful in test environments)
OTEL_ENABLED=true
# Service name attached to every span
OTEL_SERVICE_NAME=stellar-creator-portfolio
# OTLP gRPC endpoint — Jaeger all-in-one: http://localhost:4317
# Datadog Agent: http://localhost:4317 (with DD_OTLP_CONFIG_RECEIVER_PROTOCOLS_GRPC_ENDPOINT)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Sampling rate in production: 1.0 = 100%, 0.1 = 10% (default 10% in prod)
OTEL_TRACE_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Neural Search Engine / Elasticsearch (#638)
# ---------------------------------------------------------------------------
# Elasticsearch cluster URL (single node dev: http://localhost:9200)
ELASTICSEARCH_URL=http://localhost:9200
# Optional: Basic auth for Elasticsearch
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
# Optional: API key auth (preferred in prod — takes priority over basic auth)
ELASTICSEARCH_API_KEY=
# Index name for creator profiles
ELASTICSEARCH_CREATORS_INDEX=creators
# OpenAI API key for embedding generation
OPENAI_API_KEY=sk-...
# Embedding model (text-embedding-3-small = 1536 dims, text-embedding-3-large = 3072 dims)
EMBED_MODEL=text-embedding-3-small
EMBED_ENDPOINT=https://api.openai.com/v1/embeddings

# ---------------------------------------------------------------------------
# WebRTC Signaling Server (#637)
# ---------------------------------------------------------------------------
# Port the signaling server listens on
SIGNALING_PORT=3001
# Host to bind (0.0.0.0 for all interfaces in production)
SIGNALING_HOST=0.0.0.0
# HMAC secret for signing TURN credentials (generate: openssl rand -hex 32)
TURN_SECRET=your-turn-secret-here
# TURN server hostname (Coturn default)
TURN_HOST=turn.example.com
# TURN server ports
TURN_PORT=3478
TURN_TLS_PORT=5349
# STUN server URL (use Google public STUN for dev, own server in prod)
STUN_URL=stun:stun.l.google.com:19302
# Credential TTL in seconds (default 86400 = 24h)
TURN_CREDENTIAL_TTL=86400
# Max concurrent connections per process
SIGNALING_MAX_CONNECTIONS=10000
# Heartbeat interval in ms
SIGNALING_HEARTBEAT_MS=30000
# Public WebSocket URL for clients
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:3001
