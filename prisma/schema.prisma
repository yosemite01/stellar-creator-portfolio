// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_DATABASE_URL bypasses PgBouncer for Prisma migrations.
  // In production set this to the direct Postgres connection (port 5432).
  directUrl = env("DIRECT_DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  password            String?
  image               String?
  role                Role      @default(USER)
  /// Current step (1-3) in the onboarding wizard; used to resume where a
  /// user left off. Set alongside onboardingData by app/api/onboarding.
  onboardingStep      Int       @default(1)
  /// Partial per-step form data collected before final submit.
  onboardingData      Json?
  /// Null until the wizard's final step completes. Presence (not a
  /// separate boolean) is what middleware/NextAuth's jwt callback gate on.
  onboardingCompletedAt DateTime?
  /// Stellar public key (G...), set once a wallet has been linked via SEP-10.
  /// Required to attest KYC on-chain (Issue #782).
  walletAddress       String?   @unique
  /// Set while an admin suspension is in force; null for active accounts.
  suspendedAt         DateTime? @db.Timestamptz
  suspensionReason    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  verificationTokens VerificationToken[]

  // Platform specific relations
  creatorProfile CreatorProfile?
  clientProfile  ClientProfile?
  bounties       Bounty[]
  applications   BountyApplication[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  inAppNotifications     InAppNotification[]
  emailDeliveryLogs      EmailDeliveryLog[]
  emailUnsubscribeToken  String? @unique
  emailBounced           Boolean @default(false)
  matchFeedback       MatchFeedback[]
  matchNotifications  MatchNotification[]
  auditLogs           AuditLog[]
  adminSkills         AdminSkill[]
  skillSynonyms       SkillSynonym[]
  bountyTemplates     BountyTemplate[]
  apiKeys             ApiKey[]
  endorsementsGiven   Endorsement[] @relation(name: "endorsements_given")
  kycSubmission       KYCSubmission?
  testimonials        Testimonial[] @relation("testimonial_creator")
  clientTestimonials  Testimonial[] @relation("testimonial_client")
  projects            Project[]
  teamsOwned          Team[]        @relation("team_owner")
  teamMemberships     TeamMember[]
  disputeEvidence     DisputeEvidence[] @relation("dispute_evidence_uploader")
  pinnedFiles         PinnedFile[]
  pushDeviceTokens    PushDeviceToken[]
  threadMemberships   ThreadMember[]
  messagesSent        Message[]      @relation("message_sender")
  sep24Transactions   Sep24Transaction[]
  swapSessions        SwapSession[]

  @@index([email])
  @@index([suspendedAt])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@index([userId])
}

enum Role {
  USER
  CREATOR
  CLIENT
  ADMIN
}

/// Tiered trust system for creator reputation
enum VerificationTier {
  NONE
  VERIFIED  // KYC approved — blue checkmark ✓
  TRUSTED   // 10+ bounties, avg rating ≥ 4.0 — gold star ⭐
  ELITE     // 50+ bounties, avg rating ≥ 4.5, > 1 year active — diamond 💎
}

// Platform specific models
model CreatorProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  bio               String?
  avatar            String?
  discipline        String?
  skills            String[]
  portfolio         Json?
  rating            Float            @default(0)
  completedProjects Int              @default(0)
  verified          Boolean          @default(false)
  /// Tiered trust level — upgraded nightly by cron job
  verificationTier  VerificationTier @default(NONE)
  /// Timestamp when this account first became active (for Elite 1-year check)
  firstActiveAt     DateTime?
  githubUrl         String?
  figmaUrl          String?
  linkedinUrl       String?
  websiteUrl        String?
  /// Whether this creator is currently open to new bounty applications.
  /// Matching (see lib/matching-engine.ts) excludes creators where this is
  /// false, regardless of how well they'd otherwise score.
  acceptingWork     Boolean          @default(true)
  /// Rate card (issue #1609) — all optional since existing creators have
  /// none set; matching falls back to its completedProjects-based budget
  /// heuristic when neither rate field is present.
  hourlyRate        Float?
  projectRateMin    Float?
  projectRateMax    Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tierHistory    TierHistory[]
  availabilities Availability[]
  endorsements   Endorsement[]

  @@index([userId])
  @@index([discipline])
  @@index([verificationTier])
  @@index([acceptingWork])
}

/// Immutable audit trail of tier changes
model TierHistory {
  id               String           @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile   @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  previousTier     VerificationTier
  newTier          VerificationTier
  reason           String?          // e.g. "nightly_cron: 10 bounties, rating 4.2"
  triggeredBy      String           @default("system") // "system" | userId for manual overrides
  createdAt        DateTime         @default(now())

  @@index([creatorProfileId, createdAt])
  @@index([newTier])
}

/// A creator's recurring weekly availability window (e.g. "Mon 9am-5pm UTC").
model Availability {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek        Int
  startTime        String
  endTime          String
  timezone         String         @default("UTC")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([creatorProfileId])
}

/// A skill endorsement one user gives to a creator's profile.
model Endorsement {
  id               String         @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  giverId          String
  giver            User           @relation(name: "endorsements_given", fields: [giverId], references: [id], onDelete: Cascade)
  skill            String
  message          String?
  createdAt        DateTime       @default(now())

  @@unique([creatorProfileId, giverId, skill])
  @@index([creatorProfileId])
  @@index([giverId])
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  projectType String?
  budgetRange String?
  bio         String?
  avatar      String?
  verified    Boolean  @default(false)
  githubUrl   String?
  figmaUrl    String?
  linkedinUrl String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash    String    @unique
  /// Public, non-secret part of the key shown in the dashboard (see lib/api-keys.ts).
  prefix     String?   @unique
  name       String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([keyHash])
}

model Bounty {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  description String
  budget      Int
  deadline    DateTime
  status      BountyStatus @default(OPEN)
  /// Optimistic-concurrency version (#1810). Every status transition goes
  /// through server/services/bounty.service.ts `transitionBounty`, which
  /// only writes when this still matches and increments it.
  version     Int      @default(0)
  category    String?
  tags        String[]
  /// Skill level required: beginner | intermediate | advanced | expert
  difficulty  BountyDifficulty @default(beginner)
  applications BountyApplication[]
  testimonials Testimonial[]
  reviews      Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([category])
  @@index([difficulty])
}

enum BountyDifficulty {
  beginner
  intermediate
  advanced
  expert
}


enum BountyStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model BountyApplication {
  id             String   @id @default(cuid())
  bountyId       String
  bounty         Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  applicantId    String
  applicant      User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  proposal       String
  proposedBudget Int
  timeline       Int      // days
  status         ApplicationStatus @default(PENDING)
  /// Set when this is a team/agency application (issue #1610) — `applicant`
  /// is then the team's primary contact, and payout on acceptance should
  /// split across `team.members` per their `payoutSplitPercent`. Null for
  /// an ordinary solo application.
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([bountyId, applicantId])
  @@index([bountyId])
  @@index([applicantId])
  @@index([teamId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ── Teams / agencies (issue #1610) ────────────────────────────────────────
//
// A team lets several creators apply to a bounty together with an agreed
// payout split. This PR implements the team model and team-application
// flow (app/api/teams/route.ts, app/api/bounties/[id]/apply/route.ts).
//
// Deferred to a follow-up, per this issue's own "L — consider splitting
// into several PRs" sizing: enforcing the split when escrow actually pays
// out. `lib/escrow/escrow-transaction-handler.ts`'s `releaseEscrowFunds`
// credits a single `creatorId` and has no link back to the `Bounty` /
// `BountyApplication` it's for at all (neither `Escrow` nor the functions
// that call it take an application/bounty id) — that's a pre-existing gap
// this PR did not introduce. Teaching it to split across
// `TeamMember.payoutSplitPercent` needs that link added first, which is
// its own scoped change distinct from the team model itself.
model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("team_owner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  applications BountyApplication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id                 String   @id @default(cuid())
  teamId             String
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Share of the bounty payout this member receives on release (0-100).
  /// A team's members must sum to exactly 100 — enforced in
  /// app/api/teams/route.ts; Prisma/Postgres has no built-in cross-row
  /// CHECK for that here.
  payoutSplitPercent Int
  createdAt          DateTime @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Review {
  id                String       @id @default(cuid())
  creatorId         String
  reviewerId        String
  reviewerName      String
  rating            Int          // 1-5
  title             String
  body              String       @db.Text
  isVerifiedPurchase Boolean     @default(false)
  helpfulCount      Int          @default(0)
  notHelpfulCount   Int          @default(0)
  status            ReviewStatus @default(PENDING)
  /// The completed bounty this review is about (issue #1608) — required by
  /// new reviews (enforced in app/api/creators/reviews/route.ts, not here,
  /// since existing rows predate this column and have none). Also used to
  /// prevent more than one review per reviewer per engagement.
  bountyId          String?
  bounty            Bounty?      @relation(fields: [bountyId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([reviewerId, bountyId])
  @@index([creatorId])
  @@index([reviewerId])
  @@index([status])
}

model ReviewVote {
  id        String @id @default(cuid())
  reviewId  String
  userId    String
  vote      String // "helpful" | "not_helpful"

  @@unique([reviewId, userId])
  @@index([reviewId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Mobile Expo push token registered by a signed-in user, so server-side
// push can target them. Registered after sign-in and re-registered on
// token refresh (see mobile/src/services/PushNotificationService.ts
// registerPushTokenWithBackend). One row per (userId, token): the same
// physical device can get a new Expo token across reinstalls, and the
// same token should not be duplicated for a user across repeated
// registration calls (app foreground, retry, etc.).
model PushDeviceToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  platform   String // 'ios' | 'android' | 'web'
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, token])
  @@index([userId])
}

model Notification {
  id          String             @id @default(cuid())
  messageId   String?            @unique
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String
  status      NotificationStatus @default(PENDING)
  priority    String             @default("normal")
  channels    String[]
  metadata    Json?
  readAt      DateTime?
  openedAt    DateTime?
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  OPENED
  READ
  ARCHIVED
  DELETED
}
// ── Notifications & email delivery ───────────────────────────────────────────

model NotificationPreference {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailBountyAlerts       Boolean  @default(true)
  emailApplicationUpdates Boolean  @default(true)
  emailMessages           Boolean  @default(true)
  emailMarketing          Boolean  @default(false)
  inAppEnabled            Boolean  @default(true)
  /// Digest emails roll up unread in-app notifications instead of sending
  /// one email per event. DAILY by default so new users get the lower-noise
  /// behavior; NONE turns digests off entirely.
  digestFrequency         DigestFrequency @default(DAILY)
  /// Set after a digest email is queued for this user so the next run only
  /// picks up notifications that arrived since, instead of re-sending the
  /// same still-unread ones forever.
  lastDigestSentAt        DateTime?
  updatedAt               DateTime @updatedAt
}

enum DigestFrequency {
  NONE
  DAILY
  WEEKLY
}

model InAppNotification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  body          String   @db.Text
  read          Boolean  @default(false)
  applicationId String?
  bountyId      String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model EmailDeliveryLog {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail           String
  templateKey       String
  subject           String
  category          String
  status            EmailDeliveryStatus @default(QUEUED)
  provider          String?
  providerMessageId String?
  errorMessage      String?             @db.Text
  payload           Json
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model MatchFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy  String
  mode      String
  contextId String?
  matchId   String
  score     Float?
  helpful   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([strategy, helpful])
}

model MatchNotification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  body            String   @db.Text
  read            Boolean  @default(false)
  relatedBountyId String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Escrow Deadlock Prevention ───────────────────────────────────────────

model Escrow {
  id              String   @id @default(cuid())
  creatorId       String
  clientId        String
  amount          Int
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  releasedAt      DateTime?
  refundedAt      DateTime?
  disputedAt      DateTime?
  disputeReason   String?
  version         Int      @default(1)

  @@index([creatorId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([creatorId, status])
  @@index([clientId, status])
}

model Balance {
  id        String   @id @default(cuid())
  /// One balance row per user; escrow release/refund upserts on this key.
  userId    String   @unique
  available Int      @default(0)
  locked    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  escrowId  String?
  type      String
  amount    Int
  /// pending | completed | failed
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([escrowId])
  @@index([type])
}

model Dispute {
  id        String   @id @default(cuid())
  escrowId  String
  creatorId String
  clientId  String
  status    String   @default("open")
  reason    String?
  deadline  DateTime?
  evidence  DisputeEvidence[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escrowId])
  @@index([creatorId])
  @@index([clientId])
  @@index([status])
  @@index([deadline])
}

model DisputeEvidence {
  id           String   @id @default(cuid())
  disputeId    String
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("dispute_evidence_uploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  message      String?  @db.Text
  messageId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([disputeId])
  @@index([uploadedById])
}

// ── Audit Logging & Telemetry ────────────────────────────────────────────

/// Tamper-evident audit trail with hash-chain integrity protection.
/// Each entry hashes all previous entries using SHA-256 — any modification breaks the chain.
/// Records who did what, when, and from where — used for security tracing and compliance.
/// 
/// Hash chain mechanics:
/// - `prevHash`: SHA-256 of previous entry's data (null for first entry)
/// - `entryHash`: SHA-256 of current entry's data + prevHash (computed by DB trigger)
/// - Database trigger prevents UPDATE/DELETE operations to preserve integrity
/// - Periodic anchoring on Stellar provides cryptographic proof of existence
model AuditLog {
  id            String    @id @default(cuid())

  /// The authenticated user that triggered the mutation (null for unauthenticated attempts).
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// High-level category: e.g. "bounty", "application", "escrow", "profile"
  resource      String

  /// The specific action performed: e.g. "create", "update", "delete", "accept"
  action        String

  /// Primary key of the affected record (if applicable).
  resourceId    String?

  /// Sanitised snapshot of the mutation payload (no secrets, no PII beyond IDs).
  payload       Json?

  /// HTTP method of the originating request.
  httpMethod    String?

  /// Request path / route that triggered the mutation.
  requestPath   String?

  /// Outcome of the operation.
  status        AuditStatus @default(SUCCESS)

  /// Optional error message captured on failure.
  errorMessage  String?     @db.Text

  /// W3C Trace-Context traceId for distributed tracing correlation.
  traceId       String?

  /// Hashed source IP — stored as a one-way hash to avoid storing raw PII.
  ipHash        String?

  /// Raw User-Agent header (no PII, useful for bot/abuse detection).
  userAgent     String?

  /// ISO-3166-1 country code inferred from IP geo-lookup (optional).
  geoCountry    String?

  /// Hash of the previous audit entry (null for first entry).
  prevHash      String?

  /// Computed hash of this entry (SHA-256 of entry data + prevHash).
  entryHash     String    @unique @default("") // filled in by the DB trigger

  /// Whether this entry (or any prior entry) has been tampered with.
  isTampered    Boolean   @default(false)

  /// Timestamp when this entry was anchored on Stellar (optional).
  anchoredAt    DateTime?

  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([resource, action])
  @@index([resourceId])
  @@index([traceId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([entryHash])
  @@index([prevHash])
}

enum AuditStatus {
  SUCCESS
  FAILURE
  DENIED
}

// ── Soroban Sequence Management ──────────────────────────────────────────

model SequenceLock {
  accountId  String   @id
  lockedBy   String   @default("")
  lockedAt   DateTime @default(now())
  expiresAt  DateTime
  sequence   BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

model TransactionQueue {
  id          String   @id @default(cuid())
  accountId   String
  contractId  String
  method      String
  args        Json
  status      String   @default("pending")
  sequence    BigInt?
  txHash      String?
  error       String?
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  createdAt   DateTime @default(now())
  submittedAt DateTime?
  confirmedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([status])
  @@index([createdAt])
  @@index([accountId, status])
}

model SorobanTransaction {
  id          String   @id @default(cuid())
  accountId   String
  contractId  String
  method      String
  sequence    BigInt
  txHash      String   @unique
  status      String   @default("pending")
  gasUsed     BigInt?
  result      Json?
  error       String?
  submittedAt DateTime
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([txHash])
  @@index([status])
  @@unique([accountId, sequence])
}

/// Pre-fetched sequence numbers to eliminate per-request RPC calls
model SequencePool {
  id         String   @id @default(cuid())
  accountId  String
  sequence   BigInt
  reserved   Boolean  @default(false)
  reservedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([accountId, reserved])
  @@index([accountId, sequence])
}

// ── Feature Flags ─────────────────────────────────────────────────────────

/// Lightweight feature-flag table for canary releases and A/B testing
model FeatureFlag {
  id             String   @id @default(cuid())
  name           String   @unique
  enabled        Boolean  @default(false)
  /// 0–100 percentage of users who see this feature
  rolloutPercent Int      @default(0)
  /// JSON segment descriptor e.g. {"platform":"ios","role":"CREATOR"}
  userSegment    Json?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluations FeatureFlagEvaluation[]

  @@index([name])
  @@index([enabled])
}

/// Analytics log of flag evaluations for usage tracking
model FeatureFlagEvaluation {
  id        String      @id @default(cuid())
  flagId    String
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId    String?
  result    Boolean
  context   Json?
  createdAt DateTime    @default(now())

  @@index([flagId, createdAt])
  @@index([userId, createdAt])
}

// ── Skill Taxonomy Admin & Synonyms — Issue #1617 ─────────────────────────────

/// An admin-added skill not present in the built-in taxonomy
/// (`lib/skills-taxonomy.ts`'s `SKILLS_TAXONOMY`). `skillId` uses the same
/// slug shape as the built-in entries (e.g. "zig", "move-lang") so
/// `SkillSynonym.skillId` can reference either kind uniformly.
model AdminSkill {
  id          String   @id @default(cuid())
  skillId     String   @unique
  name        String
  /// Mirrors `SkillCategory` in lib/skills-taxonomy.ts — kept as a plain
  /// string (validated at the API boundary) rather than a Prisma enum so
  /// the two don't need a migration kept in lockstep by hand.
  category    String
  aliases     String[] @default([])
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  synonyms SkillSynonym[]

  @@index([skillId])
  @@index([category])
}

/// Admin-added search synonym for a skill. `skillId` can point at either a
/// built-in taxonomy id or an `AdminSkill.skillId` — resolved against both
/// at query time (see `lib/skills-taxonomy-admin.ts`), not enforced by a DB
/// foreign key, since built-ins aren't rows in this database.
model SkillSynonym {
  id      String @id @default(cuid())
  skillId String

  /// Set only when `skillId` references an `AdminSkill` — lets deleting an
  /// admin-added skill cascade-delete its synonyms. Synonyms on a built-in
  /// skill have this null and are deleted individually.
  adminSkillId String?
  adminSkill   AdminSkill? @relation(fields: [adminSkillId], references: [skillId], onDelete: Cascade)

  synonym     String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([skillId, synonym])
  @@index([skillId])
}

// ── Bounty Templates — Issue #810 ─────────────────────────────────────────────

/// Seed/system-level bounty templates shown in the "Start from template" picker.
model BountyTemplate {
  id                String   @id @default(cuid())
  category          String
  title             String
  description       String   @db.Text
  suggestedBudget   Int
  suggestedTimeline Int      // days
  requiredSkills    String[]
  /// null = system template; userId = user-saved custom template
  createdByUserId   String?
  createdBy         User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([createdByUserId])
}

// ── Zero-Knowledge Proofs — Issue #806 ───────────────────────────────────

/// Nullifier registry for replay-protection in ZK proof verification
model ZKNullifier {
  id        String   @id @default(cuid())
  nullifier String   @unique
  createdAt DateTime @default(now())

  @@index([nullifier])
}

// ── Testimonials ──────────────────────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  clientId    String
  client      User     @relation("testimonial_client", fields: [clientId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation("testimonial_creator", fields: [creatorId], references: [id], onDelete: Cascade)
  bountyId    String?
  bounty      Bounty?  @relation(fields: [bountyId], references: [id], onDelete: SetNull)
  author      String
  role        String
  quote       String   @db.Text
  rating      Int      // 1-5
  featured    Boolean  @default(false)
  videoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([creatorId])
  @@index([bountyId])
  @@index([featured])
  @@index([createdAt])
}

// ── OCR-based KYC Document Verification — Issue #782 ────────────────────

enum KYCDocumentType {
  PASSPORT
  DRIVER_LICENSE
  NATIONAL_ID
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user's submitted KYC document and its review/verification lifecycle.
/// Extracted PII fields are encrypted at rest (AWS KMS) and only ever
/// decrypted for admin review; the row (and its ciphertext) is deleted by
/// the expiry cleanup job 90 days after upload for GDPR compliance.
model KYCSubmission {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document metadata
  documentType   KYCDocumentType
  uploadedAt     DateTime        @default(now())
  /// Set by application code at creation time to uploadedAt + 90 days.
  expiresAt      DateTime

  // Extracted data, encrypted at rest with AWS KMS before storage.
  encryptedName     String
  encryptedDOB      String
  encryptedIdNumber String

  // Envelope encryption: which data key encrypted this row (see lib/kyc-envelope-encryption.ts).
  keyId      String @default("default") @map("key_id")
  keyVersion String @default("v1") @map("key_version")

  // Uploaded document in object storage
  documentKey            String?
  documentImageKey       String?
  encryptedDocumentImage String?   @db.Text
  sanitizedAt            DateTime?

  // Verification flow
  status          KYCStatus @default(PENDING)
  adminReviewedBy String?
  adminReviewedAt DateTime?
  rejectionReason String?

  // On-chain verification (backend/contracts/identity `verify_kyc`)
  verifiedOnChain Boolean @default(false)
  txHash          String? @unique

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([keyVersion], map: "idx_kyc_submissions_key_version")
  @@index([keyId], map: "idx_kyc_submissions_key_id")
}

/// Portfolio project. `description` holds sanitized rich-text HTML produced by
/// the TipTap editor (see lib/rich-text/sanitize.ts); it is sanitized again on
/// the server before every write.
model Project {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title       String
  category    String
  description String   @db.Text
  tags        String[]
  year        Int
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([category])
}

/// Files pinned to IPFS by /api/ipfs/pin (issue #1507). The CID comes from
/// the pinning provider and is unique: re-uploading identical content
/// resolves to the same row instead of creating duplicates. ownerId stays
/// null until the route requires auth (issue #1508).
model PinnedFile {
  id        String   @id @default(cuid())
  cid       String   @unique
  sha256    String
  size      Int
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([sha256])
}

/// Cross-border payment corridor analytics for Stellar PathPayment
/// operations, aggregated into 5-minute period buckets.
model CorridorPayment {
  id               String   @id @default(cuid())
  sourceCurrency   String
  destCurrency     String
  volume           BigInt
  transactionCount Int
  periodBucket     DateTime
  createdAt        DateTime @default(now())

  @@unique([sourceCurrency, destCurrency, periodBucket])
  @@index([sourceCurrency])
  @@index([destCurrency])
  @@index([periodBucket])
  @@index([sourceCurrency, destCurrency])
}

// ── Encrypted messaging (opaque ciphertext; see ADR 0007) ─────────────────

/// Conversation thread. Membership is required to read/write.
model Thread {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  members   ThreadMember[]
  messages  Message[]

  @@map("threads")
}

model ThreadMember {
  id       String   @id @default(cuid())
  threadId String   @map("thread_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  thread   Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_members")
}

/// End-to-end encrypted message. Server stores ciphertext + iv as opaque blobs
/// and never decrypts. Optional plainText is client-supplied for search only.
model Message {
  id          String   @id @default(cuid())
  threadId    String   @map("thread_id")
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  ciphertext  String   @db.Text
  iv          String
  attachment  Json?
  status      String   @default("sent")
  readBy      String[] @default([]) @map("read_by")
  metadata    Json?
  /// Client-supplied plaintext excerpt for FTS only — never derived by decrypting.
  plainText   String?  @map("plain_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation("message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// ── SEP-24 Transaction Tracking — Issue #1548 ──────────────────────────────

/// SEP-24 deposit/withdrawal transaction with full state persistence.
/// Every state transition emits a status entry for timeline display.
model Sep24Transaction {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  /// Anchor's transaction ID (from /transactions/{deposit,withdraw}/interactive response)
  anchorId             String        @unique
  /// Anchor's TRANSFER_SERVER URL
  transferServer       String
  /// deposit or withdrawal
  kind                 Sep24Kind
  /// Asset code (e.g. USDC, XLM)
  assetCode            String
  
  /// Amounts from anchor's /transaction response
  amountIn             String?
  amountOut            String?
  amountFee            String?
  
  /// Current transaction status (from anchor)
  status               Sep24Status   @default(pending_user_transfer_start)
  /// Human-readable message from anchor
  message              String?       @db.Text
  /// URL for more info from anchor
  moreInfoUrl          String?       @db.Text
  
  /// Stellar chain references (when available)
  stellarTransactionId String?
  externalTransactionId String?
  
  /// Timing
  startedAt            DateTime      @default(now())
  completedAt          DateTime?
  /// Last time we polled the anchor
  lastPolledAt         DateTime?
  
  /// Polling metadata
  pollCount            Int           @default(0)
  /// When to mark as stale (startedAt + 72h)
  staleAt              DateTime?
  
  /// Full status history for timeline display
  statusHistory        Sep24StatusEntry[]
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  @@index([userId, createdAt])
  @@index([anchorId])
  @@index([status])
  @@index([status, lastPolledAt])
}

/// Status history entry for timeline display.
/// Created on every state change via the service layer.
model Sep24StatusEntry {
  id           String        @id @default(cuid())
  transaction  Sep24Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String       @map("transaction_id")
  
  status       Sep24Status
  message      String?       @db.Text
  /// JSON metadata for debugging (e.g. raw anchor response)
  metadata     Json?
  
  createdAt    DateTime      @default(now())
  
  @@index([transactionId, createdAt])
}

enum Sep24Kind {
  deposit
  withdrawal
}

enum Sep24Status {
  incomplete
  pending_user_transfer_start
  pending_user_transfer_complete
  pending_external
  pending_anchor
  pending_stellar
  pending_trust
  pending_user
  completed
  refunded
  expired
  no_market
  too_small
  too_large
  error
}

// ── Cross-Chain Swap Sessions — Issue #1725 ────────────────────────────────

/// Cross-chain swap session with crash recovery and refund handling.
/// Tracks HTLC state, multi-leg routing, and refund progress.
model SwapSession {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Swap parameters
  fromChain        String       // ChainId enum value
  toChain          String       // ChainId enum value
  fromAmount       String
  toAmount         String
  minOut           String       // Minimum output enforced at execution
  quoteExpiry      DateTime     // Quote expires after this
  
  // Route info
  routeId          String
  hops             Json         // Route hops with fees and protocols
  
  // HTLC state
  htlcHash         String?      // SHA-256 hash for HTLC
  htlcSecret       String?      // Preimage (revealed on success)
  htlcLocktime     Int?         // Locktime in ledger seconds
  
  // State machine
  status           SwapStatus   @default(initiated)
  phase            SwapPhase    @default(initiated)
  
  // Refund tracking
  refundTxId       String?      // Refund transaction ID
  refundedAt       DateTime?
  
  // Timing
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  @@index([userId, status])
  @@index([status, phase])
  @@index([quoteExpiry, status])  // Expired cleanup
  @@index([htlcHash])
}

enum SwapStatus {
  initiated
  source_lock
  destination_claim
  completed
  refund_requested
  refunded
  error
  failed
}

enum SwapPhase {
  initiated
  source_lock
  destination_claim
  completed
  refund_requested
  refunded
  error
}
// ── Revoked Tokens ───────────────────────────────────────────────────────────

/// Revoked token registry for token invalidation across services.
/// When a token is revoked, its JTI is added here and both NextAuth and
/// Rust auth services check this list before accepting tokens.
model RevokedToken {
  jti       String   @id
  exp       DateTime
  createdAt DateTime @default(now())

  @@index([exp])
}
// ── KYC Key Rotation History ───────────────────────────────────────────────

/// Tracks key rotation history for KYC encrypted fields.
/// Enables tracking which key version was used for each encryption.
model KycKeyRotationHistory {
  id             String   @id @default(cuid())
  previousKeyId  String
  newKeyId       String
  rotatedAt      DateTime @default(now())
  rotatedBy      String?

  @@index([rotatedAt])
}

/// CSP violation reports, stored only when CSP_ENFORCE=true (app/api/csp-report).
model CSPViolation {
  id        String   @id @default(cuid())
  directive String
  blocked   String
  document  String
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([directive])
}

// ── Transactional Outbox for Domain Events (#1759) ───────────────────────────

model OutboxEvent {
  id          String            @id @default(cuid())
  eventId     String            @unique
  eventType   String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  retryCount  Int               @default(0)
  maxRetries  Int               @default(5)
  lastError   String?           @db.Text
  createdAt   DateTime          @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([eventType])
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}
